        // STATE MANAGEMENT
        let currentSelectedGame = null;
        let currentStep = 0;
        let studentData = { name: '', id: '' };

        // INITIALIZE SIMULATOR
        function startSimulation() {
            const nameInput = document.getElementById('student-name').value.trim();
            const idInput = document.getElementById('student-id').value.trim();

            if (!nameInput || !idInput) {
                alert('Por favor ingresa tu Nombre Completo y Matrícula para iniciar el examen.');
                return;
            }

            studentData.name = nameInput;
            studentData.id = idInput;

            // Pick a random game pitch
            const randomIndex = Math.floor(Math.random() * GAMES_DATABASE.length);
            currentSelectedGame = GAMES_DATABASE[randomIndex];

            // Populate Client Info into Step 1
            document.getElementById('client-name').innerText = currentSelectedGame.clientName;
            document.getElementById('client-role').innerText = currentSelectedGame.clientRole;
            document.getElementById('client-company').innerText = currentSelectedGame.company;
            document.getElementById('client-avatar').src = currentSelectedGame.avatar;
            document.getElementById('client-pitch').innerText = `"${currentSelectedGame.pitch}"`;
            document.getElementById('client-hint').innerText = currentSelectedGame.hint;
            document.getElementById('header-client-name').innerText = currentSelectedGame.name + ' (Caso Oculto)';

            // Auto-fill work-in-progress title placeholder in Step 4
            document.getElementById('gdd-title').placeholder = `Proyecto inspirado en: ${currentSelectedGame.name}`;

            // Show Header status & Step 1
            document.getElementById('header-status').classList.remove('hidden');
            goToStep(1);
        }

        // NAVIGATION LOGIC BETWEEN STEPS
        function goToStep(stepNumber) {
            // Hide all steps
            for (let i = 0; i <= 5; i++) {
                const stepEl = document.getElementById(`step-${i}`);
                if (stepEl) stepEl.classList.add('hidden');
            }

            // Show target step
            const targetStep = document.getElementById(`step-${stepNumber}`);
            if (targetStep) targetStep.classList.remove('hidden');

            currentStep = stepNumber;

            // Update Header Step Indicator
            const stepNames = {
                1: '01. Análisis Inicial',
                2: '02. Player Persona (Bartle)',
                3: '03. Gamification Canvas',
                4: '04. One Page Document',
                5: '05. Resultados & Evaluación'
            };

            const headerStepEl = document.getElementById('header-step-name');
            if (headerStepEl && stepNames[stepNumber]) {
                headerStepEl.innerText = stepNames[stepNumber];
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // EVALUATION ENGINE & SCORING ALGORITHM
        function submitEvaluation() {
            // Gather Student Inputs
            const genre = document.getElementById('input-genre').value;
            const coreMechanic = document.getElementById('input-core-mechanic').value.toLowerCase();
            const immersionRadio = document.querySelector('input[name="immersion-type"]:checked');
            const immersion = immersionRadio ? immersionRadio.value : '';
            const narrative = document.getElementById('input-narrative').value;

            const personaBartlePrimary = document.getElementById('persona-bartle-primary').value;
            const personaBartleSecondary = document.getElementById('persona-bartle-secondary').value;
            const personaMotivations = document.getElementById('persona-motivations').value;

            const gmcObjective = document.getElementById('gmc-objective').value;
            const gmcLoopDesc = document.getElementById('gmc-loop-desc').value;

            const gddHook = document.getElementById('gdd-hook').value;
            const gddMonetization = document.getElementById('gdd-monetization').value;

            // Validation check
            if (!genre || !coreMechanic || !personaBartlePrimary || !gmcLoopDesc || !gddHook) {
                alert('Por favor completa todos los campos clave de análisis antes de enviar la evaluación.');
                return;
            }

            // Calculate Scoring Breakdown (Total: 100 PTS)
            let scoreGenre = 0;
            let scoreMechanics = 0;
            let scoreBartle = 0;
            let scoreImmersion = 0;
            let scoreGMC = 0;
            let scoreGDD = 0;

            let feedbackList = [];

            // 1. Genre Evaluation (15 pts)
            if (genre === currentSelectedGame.correctGenre) {
                scoreGenre = 15;
                feedbackList.push({
                    title: 'Identificación de Género (15/15 pts)',
                    status: 'success',
                    msg: `¡Excelente! Identificaste correctamente el género exacto (${genre}).`
                });
            } else {
                scoreGenre = 5;
                feedbackList.push({
                    title: 'Identificación de Género (5/15 pts)',
                    status: 'warning',
                    msg: `El género seleccionado (${genre}) se aleja del marco principal del cliente (${currentSelectedGame.correctGenre}).`
                });
            }

            // 2. Core Mechanics Keyword Match (20 pts)
            let mechanicMatchCount = 0;
            currentSelectedGame.keyMechanicsKeywords.forEach(kw => {
                if (coreMechanic.includes(kw)) mechanicMatchCount++;
            });

            if (mechanicMatchCount >= 2 || coreMechanic.length > 40) {
                scoreMechanics = 20;
                feedbackList.push({
                    title: 'Definición de Core Loop & Mecánica (20/20 pts)',
                    status: 'success',
                    msg: 'Describiste las mecánicas de juego clave con alta propiedad técnica y alineación al pitch.'
                });
            } else {
                scoreMechanics = 10;
                feedbackList.push({
                    title: 'Definición de Core Loop & Mecánica (10/20 pts)',
                    status: 'warning',
                    msg: 'La descripción de la mecánica fue superficial. Se requiere profundizar en los inputs y respuestas del juego.'
                });
            }

            // 3. Bartle Player Types Alignment (20 pts)
            if (personaBartlePrimary === currentSelectedGame.primaryBartle) {
                scoreBartle = 20;
                feedbackList.push({
                    title: 'Taxonomía de Bartle (20/20 pts)',
                    status: 'success',
                    msg: `Perfecta alineación del Player Persona. El tipo primario adecuado es ${currentSelectedGame.primaryBartle}.`
                });
            } else if (personaBartlePrimary === currentSelectedGame.secondaryBartle) {
                scoreBartle = 14;
                feedbackList.push({
                    title: 'Taxonomía de Bartle (14/20 pts)',
                    status: 'info',
                    msg: `Seleccionaste el arquetipo secundario (${personaBartlePrimary}). El dominante clave era ${currentSelectedGame.primaryBartle}.`
                });
            } else {
                scoreBartle = 6;
                feedbackList.push({
                    title: 'Taxonomía de Bartle (6/20 pts)',
                    status: 'error',
                    msg: `El tipo de jugador elegido (${personaBartlePrimary}) no encaja con la motivación intrínseca del target.`
                });
            }

            // 4. Immersion Alignment (15 pts)
            if (immersion === currentSelectedGame.immersionIdeal) {
                scoreImmersion = 15;
                feedbackList.push({
                    title: 'Modelo de Inmersión (15/15 pts)',
                    status: 'success',
                    msg: `Selección óptima de inmersión (${immersion}). Conecta directamente con la psicología de la experiencia.`
                });
            } else {
                scoreImmersion = 8;
                feedbackList.push({
                    title: 'Modelo de Inmersión (8/15 pts)',
                    status: 'warning',
                    msg: `El tipo de inmersión seleccionada es secundaria. Para este tipo de juego se prioriza la inmersión ${currentSelectedGame.immersionIdeal}.`
                });
            }

            // 5. Gamification Model Canvas Completeness (15 pts)
            if (gmcLoopDesc.length > 30 && gmcObjective.length > 5) {
                scoreGMC = 15;
                feedbackList.push({
                    title: 'Gamification Model Canvas (15/15 pts)',
                    status: 'success',
                    msg: 'El bucle de feedback (Trigger-Action-Reward) se encuentra bien fundamentado en el canvas.'
                });
            } else {
                scoreGMC = 7;
                feedbackList.push({
                    title: 'Gamification Model Canvas (7/15 pts)',
                    status: 'warning',
                    msg: 'Falta detalle en la descripción de los disparadores y el sistema de recompensas.'
                });
            }

            // 6. One Page GDD Hook & Pitch (15 pts)
            if (gddHook.length > 25 && gddMonetization) {
                scoreGDD = 15;
                feedbackList.push({
                    title: 'One Page Document Executive (15/15 pts)',
                    status: 'success',
                    msg: 'La Propuesta Única de Valor (USP) y el modelo de negocio demuestran viabilidad comercial.'
                });
            } else {
                scoreGDD = 8;
                feedbackList.push({
                    title: 'One Page Document Executive (8/15 pts)',
                    status: 'warning',
                    msg: 'El pitch comercial (High Concept Hook) requiere mayor impacto para convencer a los inversores.'
                });
            }

            // Total Score
            const totalScore = scoreGenre + scoreMechanics + scoreBartle + scoreImmersion + scoreGMC + scoreGDD;
            const weightedScore = ((totalScore / 100) * 30).toFixed(1);

            // Populate Results Screen
            document.getElementById('final-score').innerText = `${totalScore} / 100`;
            document.getElementById('weighted-score').innerText = `${weightedScore}% / 30%`;
            document.getElementById('res-student-name').innerText = studentData.name;
            document.getElementById('res-student-id').innerText = studentData.id;
            document.getElementById('res-game-title').innerText = currentSelectedGame.name;

            // Status Badge
            const statusEl = document.getElementById('grade-status');
            if (totalScore >= 85) {
                statusEl.innerText = 'Desempeño Sobresaliente';
                statusEl.className = 'text-xs font-bold mt-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
            } else if (totalScore >= 70) {
                statusEl.innerText = 'Competente / Aprobado';
                statusEl.className = 'text-xs font-bold mt-2 px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-400 border border-indigo-500/30';
            } else {
                statusEl.innerText = 'Requiere Recompensado / Formación';
                statusEl.className = 'text-xs font-bold mt-2 px-3 py-1 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30';
            }

            // Render Feedback List
            const feedbackContainer = document.getElementById('feedback-container');
            feedbackContainer.innerHTML = '';

            feedbackList.forEach(item => {
                let borderClass = 'border-slate-800';
                let iconClass = 'fa-info-circle text-indigo-400';

                if (item.status === 'success') {
                    borderClass = 'border-emerald-900/40 bg-emerald-950/20';
                    iconClass = 'fa-circle-check text-emerald-400';
                } else if (item.status === 'warning') {
                    borderClass = 'border-amber-900/40 bg-amber-950/20';
                    iconClass = 'fa-triangle-exclamation text-amber-400';
                } else if (item.status === 'error') {
                    borderClass = 'border-rose-900/40 bg-rose-950/20';
                    iconClass = 'fa-circle-xmark text-rose-400';
                }

                const card = document.createElement('div');
                card.className = `p-4 rounded-xl border ${borderClass} space-y-2`;
                card.innerHTML = `
                    <div class="flex items-center space-x-2">
                        <i class="fa-solid ${iconClass}"></i>
                        <h4 class="text-xs font-bold text-white">${item.title}</h4>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">${item.msg}</p>
                `;
                feedbackContainer.appendChild(card);
            });

            goToStep(5);
        }

        // RESET SIMULATOR
        function restartSimulator() {
            if (confirm('¿Deseas reiniciar la evaluación e iniciar un nuevo encargo de cliente?')) {
                // Clear inputs
                document.getElementById('input-genre').value = '';
                document.getElementById('input-core-mechanic').value = '';
                document.getElementById('input-narrative').value = '';
                document.getElementById('persona-name').value = '';
                document.getElementById('persona-bartle-primary').value = '';
                document.getElementById('persona-bartle-secondary').value = '';
                document.getElementById('persona-frustrations').value = '';
                document.getElementById('persona-motivations').value = '';
                document.getElementById('gmc-objective').value = '';
                document.getElementById('gmc-aesthetic').value = '';
                document.getElementById('gmc-triggers').value = '';
                document.getElementById('gmc-actions').value = '';
                document.getElementById('gmc-feedback').value = '';
                document.getElementById('gmc-rewards').value = '';
                document.getElementById('gmc-loop-desc').value = '';
                document.getElementById('gdd-title').value = '';
                document.getElementById('gdd-tech').value = '';
                document.getElementById('gdd-hook').value = '';
                document.getElementById('gdd-monetization').value = '';
                document.getElementById('gdd-target').value = '';

                goToStep(0);
            }
        }
    </script>
</body>
</html>
